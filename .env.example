# Docker Compose settings (compose.yaml). Copy to .env to override the defaults.
# If you change credentials here, change the same values in apps/akita-api/.env.

# PostgreSQL
POSTGRES_USER=akita
POSTGRES_PASSWORD=akita
POSTGRES_DB=akita
POSTGRES_PORT=5432

# MinIO (S3-compatible storage). The access keys are MinIO's root credentials.
S3_ACCESS_KEY_ID=akita
S3_SECRET_ACCESS_KEY=akita-secret
S3_BUCKET=akita
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# Origin allowed to call MinIO from the browser (CORS).
WEB_ORIGIN=http://localhost:3000

# Mailpit (SMTP server and web inbox)
SMTP_PORT=1025
MAILPIT_UI_PORT=8025
