# Copy to .env. Defaults match the services in the root compose.yaml.

# Port the API listens on.
PORT=4000
# Origin of akita-web, used for CORS.
WEB_ORIGIN=http://localhost:3000

# PostgreSQL connection string.
DATABASE_URL=postgresql://akita:akita@localhost:5432/akita

# S3-compatible object storage (MinIO locally).
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=akita
S3_SECRET_ACCESS_KEY=akita-secret
S3_BUCKET=akita

# Outgoing mail (Mailpit locally; inbox at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Akita <no-reply@akita.local>
