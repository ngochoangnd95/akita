{
	"name": "akita-api",
	"private": true,
	"type": "module",
	"module": "src/index.ts",
	"scripts": {
		"build": "bun build src/index.ts --compile --minify-whitespace --minify-syntax --bytecode --target bun --outfile dist/akita-api",
		"check": "biome check",
		"check:fix": "biome check --write",
		"dev": "bun run --watch src/index.ts",
		"start": "./dist/akita-api",
		"test": "bun test",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"elysia": "^1.4.30",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@repo/biome-config": "workspace:*",
		"bun-types": "catalog:",
		"typescript": "catalog:"
	}
}
