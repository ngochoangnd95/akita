{
	"name": "akita-web",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun --bun vite build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"dev": "bun --bun vite dev",
		"generate-routes": "tsr generate",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide --strategy url baseLocale --silent",
		"preview": "bun --bun vite preview",
		"test": "bun test",
		"typecheck": "bun run i18n:compile && tsc --noEmit"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"@fontsource-variable/inter": "^5.3.0",
