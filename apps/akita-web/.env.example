# Copy to .env.

# Port the web server listens on.
PORT=3000
# Base URL of akita-api, used by server-side code.
API_URL=http://localhost:4000

# Better Auth (moves to akita-api in issue #4).
BETTER_AUTH_URL=http://localhost:3000
# At least 32 characters. Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-a-random-secret-of-32-chars
