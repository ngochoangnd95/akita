{
	"name": "akita",
	"private": true,
	"type": "module",
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"typescript": "^7.0.2",
			"@biomejs/biome": "2.5.14",
			"@types/react": "^19.3.0",
			"@types/react-dom": "^19.3.0",
			"react": "^19.3.0",
			"react-dom": "^19.3.0",
			"zod": "^4.6.5",
			"bun-types": "^1.4.2"
		}
	},
	"scripts": {
		"check": "biome check && bun --workspaces run check",
		"check:fix": "biome check --write && bun --workspaces run check:fix",
		"test": "bun test",
		"typecheck": "bun --workspaces run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "catalog:",
		"@repo/biome-config": "workspace:*"
	},
	"packageManager": "bun",
	"engines": {
		"runtime": [
			{
				"name": "bun",
				"version": "^1.4.2"
			}
		]
	},
	"intent": {
		"skills": [
			"@tanstack/*",
			"dotenv"
		]
	}
}
